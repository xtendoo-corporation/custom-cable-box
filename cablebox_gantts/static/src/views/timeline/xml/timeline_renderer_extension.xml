<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web_timeline.TimelineView" t-inherit-mode="extension">
        <!-- Removed invalid props injection: Layout/SearchBar do not accept a `resModel` prop
             Passing `resModel` here caused Owl validation errors (unknown key 'resModel').
             If later needed, pass model information via the controller/renderer JS code instead. -->
    </t>

    <t t-inherit="web_timeline.TimelineRenderer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('btn-group')]/button[1]" position="attributes">
            <attribute name="t-if">scales &amp;&amp; scales.includes('day')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('btn-group')]/button[2]" position="attributes">
            <attribute name="t-if">scales &amp;&amp; scales.includes('week')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('btn-group')]/button[3]" position="attributes">
            <attribute name="t-if">scales &amp;&amp; scales.includes('month')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('btn-group')]/button[4]" position="attributes">
            <attribute name="t-if">scales &amp;&amp; scales.includes('year')</attribute>
        </xpath>
    </t>
</templates>

