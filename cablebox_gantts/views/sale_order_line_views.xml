<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Timeline View -->
    <record id="view_sale_order_line_timeline_cablebox" model="ir.ui.view">
        <field name="name">sale.order.line.timeline.cablebox</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <timeline date_start="date_order"
                      date_stop="commitment_date_line"
                      default_group_by="display_group"
                      unique_by="order_id"
                      group_label_date="date_order"
                      group_order_date="date_order"
                      event_open_popup="true"
                      scrollToToday="true"
                      mode="month"
                      scales="month"
                      colors="#005FAA:delivery_status_percentage &lt; 100; #005FAA:delivery_status_percentage == 100;">
                <field name="order_id"/>
                <field name="display_group"/>
                <field name="product_id"/>
                <field name="client_order_ref_line"/>
                <field name="delivery_status_percentage"/>
                <field name="x_ref_sap"/>
                <field name="tag_ids"/>
                <field name="tags_string"/>
                <templates>
                    <t t-name="timeline-item">
                        <div class="o_project_timeline_item" style="color: white !important;">
                            <span name="display_name">
                                <t t-if="record.order_id" t-esc="record.order_id[1]"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </timeline>
        </field>
    </record>

    <!-- List View -->
    <record id="view_sale_order_line_tree_cablebox" model="ir.ui.view">
        <field name="name">sale.order.line.list.cablebox</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Estado de Entrega" decoration-info="delivery_status_percentage &lt; 100" decoration-success="delivery_status_percentage == 100">
                <field name="client_order_ref_line" string="Pedido SAP"/>
                <field name="order_id" string="Pedido Odoo"/>
                <field name="product_id"/>
                <field name="product_uom_qty" string="Unidades"/>
                <field name="qty_delivered" string="Entregado"/>
                <field name="delivery_status_percentage" string="%" widget="progressbar"/>
                <field name="date_order" string="Fecha Pedido"/>
                <field name="recepcion_entrega"/>
                <field name="state" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_order_form_cablebox_delivery_reception" model="ir.ui.view">
        <field name="name">sale.order.form.cablebox.delivery.reception</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="recepcion_entrega" optional="show" column_invisible="parent.state != 'sale'"/>
            </xpath>
        </field>
    </record>

    <record id="sale_report_view_tree_cablebox_delivery_reception" model="ir.ui.view">
        <field name="name">sale.report.list.cablebox.delivery.reception</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="recepcion_entrega" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_sale_order_line_pivot_cablebox" model="ir.ui.view">
        <field name="name">sale.order.line.pivot.cablebox</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Estado de Entrega" sample="1">
                <field name="client_order_ref_line" type="row"/>
                <field name="order_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="qty_delivered" type="measure"/>
                <field name="delivery_status_percentage" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View Inheritance -->
    <record id="view_sale_order_line_search_cablebox" model="ir.ui.view">
        <field name="name">sale.order.line.search.cablebox</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_id']" position="after">
                <field name="salesman_id" string="Comercial" widget="many2one"/>
                <field name="x_ref_sap" string="Ref. SAP"/>
            </xpath>
            <xpath expr="//filter[@name='to_invoice']" position="after">
                <separator/>
                <filter string="Pendientes" name="pending" domain="[('delivery_status_percentage', '&lt;', 100)]"/>
                <filter string="Entregados" name="delivered" domain="[('delivery_status_percentage', '=', 100)]"/>
                <separator/>
                <filter string="Fecha Pedido" name="date_order_filter" date="date_order"/>
            </xpath>
            <xpath expr="//filter[@name='my_sales_order_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Año Pedido" name="group_year" context="{'group_by': 'date_order:year'}"/>
            </xpath>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sale_order_line_delivery_status" model="ir.actions.act_window">
        <field name="name">Estado de Entrega</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">timeline,list,pivot,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="domain">[('state', '=', 'sale')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay líneas de pedido para mostrar. Asegúrese de que los pedidos estén confirmados y tengan fecha de entrega.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_sale_order_line_delivery_status"
              name="Estado de Entrega"
              action="action_sale_order_line_delivery_status"
              parent="sale.menu_sale_report"
              sequence="10"/>
</odoo>
