<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cablebox_import_pricelist_wizard_form" model="ir.ui.view">
        <field name="name">cablebox.import.pricelist.wizard.form</field>
        <field name="model">cablebox.import.pricelist.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar tarifas desde Excel">
                <sheet>
                    <group>
                        <p>
                            Se importará únicamente la primera hoja del Excel.
                            El nombre de la tarifa será el nombre de esa hoja.
                        </p>
                    </group>
                    <group>
                        <field name="filename" invisible="1" />
                        <field name="data_file" filename="filename" string="Archivo Excel" />
                        <field name="price_source" />
                        <field name="replace_existing_items" />
                    </group>
                    <group>
                        <p>
                            <strong>Columnas usadas:</strong>
                            <br />- B: CÓDIGO DE PRODUCTO
                            <br />- C: CÓDIGO EAN (opcional, como respaldo)
                            <br />- J o K: PRECIO AL DISTRIBUIDOR / PRECIO AL PÚBLICO
                            <br />- M: CÓDIGO DE MONEDA (opcional)
                        </p>
                    </group>
                    <group>
                        <p class="text-muted">
                            El importador asume el formato estándar del Excel y lee esas posiciones directamente.
                        </p>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_import"
                        string="Importar tarifas"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cablebox_import_pricelist_wizard" model="ir.actions.act_window">
        <field name="name">Importar tarifas</field>
        <field name="res_model">cablebox.import.pricelist.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

