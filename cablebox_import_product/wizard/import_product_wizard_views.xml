<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="import_product_wizard_form" model="ir.ui.view">
        <field name="name">import.product.wizard.form</field>
        <field name="model">import.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Poner Costes a 0">
                <group>
                    <p class="text-danger"> Esta acción buscará todos los productos del sistema y
                        pondrá su Coste (standard_price) a 0.00. <br /> ¿Desea continuar? </p>
                </group>
                <footer>
                    <button name="action_import" string="Poner a 0" type="object"
                        class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_product_wizard" model="ir.actions.act_window">
        <field name="name">Poner Costes a 0</field>
        <field name="res_model">import.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>