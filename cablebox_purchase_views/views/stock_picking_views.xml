<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista de lista de albaranes para añadir el campo 'Documento de Compra' -->
    <record id="view_picking_tree_custom_purchase" model="ir.ui.view">
        <field name="name">stock.picking.tree.custom.purchase</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">

            <xpath expr="//list/field[last()]" position="after">
                <field name="sale_origin" string="Pedido de Cliente" optional="show" />
                <field name="purchase_origin" string="Pedido de Compra" optional="show" />
                <field name="purchase_document_origin" string="Documento origen Compra"
                    optional="show" />
            </xpath>
            <!-- Reemplazar la columna 'origin' por el campo relacionado 'x_sale_origin' -->
            <xpath expr="//list/field[@name='origin']" position="replace">
                <field name="x_sale_origin" string="Documento origen Venta" optional="show" />
            </xpath>
        </field>
    </record>

    <!-- Heredar la vista de formulario para ocultar origin en recepciones y mostrar documento de origen compra -->
    <record id="view_picking_form_custom_purchase" model="ir.ui.view">
        <field name="name">stock.picking.form.custom.purchase</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">picking_type_code == 'incoming'</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="purchase_document_origin" invisible="picking_type_code != 'incoming'" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>