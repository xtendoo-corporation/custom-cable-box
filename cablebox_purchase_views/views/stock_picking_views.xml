<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar la vista de lista de albaranes para añadir el campo 'Documento de Compra' -->
    <record id="view_picking_tree_custom_purchase" model="ir.ui.view">
        <field name="name">stock.picking.tree.custom.purchase</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <!-- Añadir la columna al final de la lista, con edición inline habilitada -->
            <xpath expr="//list" position="attributes">
                <attribute name="editable">top</attribute>
            </xpath>
            <xpath expr="//list/field[last()]" position="after">
                <field name="sale_id" string="Pedido de Cliente" optional="show" />
                <field name="purchase_origin" string="Documento origen Compra" optional="show" />
            </xpath>
            <!-- Reemplazar la columna 'origin' por el campo relacionado 'x_sale_origin' -->
            <xpath expr="//list/field[@name='origin']" position="replace">
                <field name="x_sale_origin" string="Documento origen Venta" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>