<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_tree_inherit_cablebox" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.cablebox</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_ref_sap" string="Ref. SAP" optional="show" />
                <field name="x_proyecto" string="Proyecto" optional="show" />
                <field name="origin" string="Documento origen" optional="show" />
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_cablebox" model="ir.ui.view">
        <field name="name">sale.order.quotation.tree.inherit.cablebox</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_ref_sap" string="Ref. SAP" optional="show" />
                <field name="x_proyecto" string="Proyecto" optional="show" />
                <field name="origin" string="Documento origen" optional="show" />
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_inherit_cablebox" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cablebox</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_reporting']/field[@name='origin']" position="after">
                <field name="x_proyecto" string="Proyecto" />
                <field name="x_ref_sap" string="Ref. SAP" />
            </xpath>
        </field>
    </record>
</odoo>