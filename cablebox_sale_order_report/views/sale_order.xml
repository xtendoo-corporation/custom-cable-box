<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_tree_inherit_cablebox" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.cablebox</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="client_order_ref" string="Ref. SAP" optional="show" />
                <field name="project_id" string="Proyecto" optional="show" />
                <field name="origin" string="Documento origen" optional="show" />
            </field>
            <field name="activity_ids" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="company_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>