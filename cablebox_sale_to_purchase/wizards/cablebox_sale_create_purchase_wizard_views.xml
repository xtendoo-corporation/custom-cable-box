<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cablebox_sale_create_purchase_wizard_form" model="ir.ui.view">
        <field name="name">cablebox.sale.create.purchase.wizard.form</field>
        <field name="model">cablebox.sale.create.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Elegir proveedor">
                <field name="sale_id" invisible="1"/>
                <group>
                    <field name="vendor_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Crear Compra" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
