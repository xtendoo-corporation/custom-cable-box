#. module: sale_order_type_mandatory_prefix
#: model:ir.model.fields,field_description:sale_order_type_mandatory_prefix.field_res_company__sale_order_type_mandatory_prefix
#: model:ir.model.fields,field_description:sale_order_type_mandatory_prefix.field_res_config_settings__sale_order_type_mandatory_prefix
msgid "Mandatory Sequence on Sale Order Type"
msgstr "Secuencia obligatoria en el Tipo de Pedido de Venta"

#. module: sale_order_type_mandatory_prefix
#: model:ir.model.fields,field_description:sale_order_type_mandatory_prefix.field_sale_order_type__sequence_id_required
msgid "Sequence Required"
msgstr "Secuencia obligatoria"

#. module: sale_order_type_mandatory_prefix
#: model:ir.model.fields,help:sale_order_type_mandatory_prefix.field_res_company__sale_order_type_mandatory_prefix
#: model:ir.model.fields,help:sale_order_type_mandatory_prefix.field_res_config_settings__sale_order_type_mandatory_prefix
msgid ""
"If checked, the sequence (prefix) field will be empty by default and will be"
" required before saving a Sale Order Type."
msgstr ""
"Si está marcado, el campo de secuencia (prefijo) estará vacío por defecto y "
"será obligatorio antes de guardar un Tipo de Pedido de Venta."

#. module: sale_order_type_mandatory_prefix
#: model:ir.model.fields,help:sale_order_type_mandatory_prefix.field_sale_order_type__sequence_id_required
msgid "Technical field: True when the company setting forces a mandatory sequence."
msgstr "Campo técnico: Verdadero cuando la configuración de la empresa exige una secuencia obligatoria."

