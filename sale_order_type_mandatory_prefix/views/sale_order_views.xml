<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_form_date_order_editable" model="ir.ui.view">
        <field name="name">sale.order.form.date.order.editable</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']/field[@name='date_order'][1]" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']/field[@name='date_order'][2]" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_date_order_editable" model="ir.ui.view">
        <field name="name">sale.order.tree.date.order.editable</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="arch" type="xml">
            <field name="date_order" position="attributes">
                <attribute name="readonly">False</attribute>
            </field>
        </field>
    </record>
</odoo>

